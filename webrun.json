{
    "permissions": {
        "run": true,
        "env": [
            "*"
        ],
        "binaries": [
            ["src"],
            ["integration"],
            ["webrun"]
        ],
        "storage": {
            "test_storage": {
                "access": "write"
            },
            "src": {
                "access": "read"
            },
            "integration": {
                "access": "read"
            }
        },
        "network": [
            "*"
        ],
        "tcp": true,
        "webrtc": true,
        "delegate": {
            "examples/": {
                "storage": {
                    ".": { "access": "read" }
                },
                "network": [
                    "*"
                ],
                "run": true,
                "env": [
                    "HF_HOME",
                    "HF_HUB_CACHE",
                    "LLAMA_CACHE",
                    "HOME",
                    "SSL_CERT_FILE",
                    "SSL_CERT_DIR",
                    "NIX_SSL_CERT_FILE"
                ],
                "binaries": [
                    ["llama-server"]
                ],
                "gpu": true
            }
        }
    },
    "limits": {
        "memoryMB": 1024
    }
}
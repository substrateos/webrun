[
  {
    "name": "Runtime Subprocess Crash: Sandbox intercepts crash gracefully, logs tail simulation and stderr",
    "args": [
      
      "test.js"
    ],
    "expect": {
      "exit_code": 0,
      "stdout": [
        {
          "contains": "CRASH_PROXY_OK"
        }
      ],
      "stderr": [
        {
          "contains": "[webrun binding: crash_backend]"
        },
        {
          "contains": "Service terminated unexpectedly (Code: 1)"
        },
        {
          "contains": "$ tail -n 15"
        },
        {
          "contains": "MOCK_STDERR_CRITICAL_FAILURE"
        }
      ]
    },
    "runner": "cli"
  }
]

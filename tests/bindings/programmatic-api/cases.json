[
  {
    "name": "ctx.webrun correctly evaluates inline code",
    "args": ["src/eval.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "EVAL_OK"}] }
  },
  {
    "name": "ctx.webrun correctly executes target script in a sub-worker",
    "args": ["src/parent.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "PARENT_OK"}] }
  },
  {
    "name": "ctx.webrun isolates CLI arguments from the parent explicitly",
    "args": ["src/parent_args.js", "--parent-flag", "--", "parent-positional"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "PARENT_ARGS_OK"}] }
  },
  {
    "name": "ctx.webrun respects SandboxOptions timeout constraints",
    "args": ["src/timeout.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "TIMEOUT_OK"}] }
  },
  {
    "name": "ctx.webrun correctly delegates positional arguments independent of explicit target routing",
    "args": ["src/pos_parent.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "POS_TARGET_OK"}] }
  },
  {
    "name": "ctx.webrun throws target missing error matching CLI instead of implicit inheritance",
    "args": ["src/no_target.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "STRICT_TARGET_OK"}] }
  },
  {
    "name": "ctx injects standard Web Streams for stdin, stdout and stderr securely",
    "args": ["src/stream.js"],
    "expect": { "exit_code": 0, "stdout": [{"contains": "STREAMS_OK"}] }
  }
]

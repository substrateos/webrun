{
  "isolate": ["child_safe/secrets", "child_unsafe/secrets"],
  "bindings": {
    "safe": { "isolate": true, "process": { "command": ["echo"] } },
    "unsafe": { "process": { "command": ["echo"] } }
  },
  "permissions": {
    "storage": { 
      "child_safe": { "access": "read" },
      "child_unsafe": { "access": "read" }
    },
    "delegate": {
      "child_safe": {
        "storage": { 
          ".": { "access": "read" },
          "secrets": { "access": "read" }
        },
        "bindings": ["safe"]
      },
      "child_unsafe": {
        "storage": {
          ".": { "access": "read" },
          "secrets": { "access": "read" }
        },
        "bindings": ["unsafe"]
      }
    }
  }
}

[
  {
    "name": "Scrubs injected host environment variables",
    "args": [
      "src/env_scrub.js"
    ],
    "runners": [
      "cli",
      "deno-shim"
    ],
    "expect_webrun": {
      "exit_code": 1,
      "stderr": [
        {
          "contains": "DENO_BLOCKED: Runtime does not support Deno env mapping"
        }
      ]
    },
    "expect_deno": {
      "exit_code": 1,
      "stderr": [
        {
          "contains": "LEAKED: pwned"
        }
      ]
    },
    "env": {
      "SUPER_SECRET_VAR": "pwned"
    }
  }
]
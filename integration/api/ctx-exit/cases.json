[
  {
    "name": "ctx.exit(0) exits cleanly with code 0",
    "args": ["src/exit_zero.js"],
    "expect": {
      "exit_code": 0,
      "stderr": [{"absent": "Uncaught"}]
    }
  },
  {
    "name": "ctx.exit(42) exits with code 42 and no stderr noise",
    "args": ["src/exit_nonzero.js"],
    "expect": {
      "exit_code": 42,
      "stderr": [{"absent": "Uncaught"}]
    }
  },
  {
    "name": "Throwing produces Uncaught Error banner with stack trace",
    "args": ["src/throw_error.js"],
    "expect": {
      "exit_code": 1,
      "stderr": [{"contains": "Uncaught"}, {"contains": "boom"}, {"contains": "throw_error.js"}]
    }
  },
  {
    "name": "Implicit exit(0) when main function returns normally",
    "args": ["src/return_normal.js"],
    "expect": {
      "exit_code": 0,
      "stderr": [{"absent": "Uncaught"}]
    }
  },
  {
    "name": "stdout and stderr are flushed before ctx.exit",
    "args": ["src/flush_before_exit.js"],
    "expect": {
      "exit_code": 0,
      "stdout": [{"contains": "STDOUT_BEFORE_EXIT"}],
      "stderr": [{"contains": "STDERR_BEFORE_EXIT"}, {"absent": "Uncaught"}]
    }
  },
  {
    "name": "Heavy stdout output is fully flushed before ctx.exit",
    "args": ["src/flush_heavy.js"],
    "expect": {
      "exit_code": 0,
      "stdout": [{"contains": "LINE_0"}, {"contains": "LINE_99"}],
      "stderr": [{"contains": "STDERR_FINAL"}, {"absent": "Uncaught"}]
    }
  }
]

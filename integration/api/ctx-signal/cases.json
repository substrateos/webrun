[
  {
    "name": "ctx.signal is an AbortSignal with initial aborted=false",
    "args": ["src/abort_signal_check.js"],
    "expect": {
      "exit_code": 0,
      "stdout": [{"contains": "ABORTED_FALSE"}, {"contains": "IS_ABORT_SIGNAL"}]
    }
  },
  {
    "name": "ctx.signal receives SIGTERM and handler runs",
    "args": ["src/trap_sigterm.js"],
    "signal": "SIGTERM",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 0,
      "ready": { "stdout": [{"contains": "READY"}] },
      "stdout": [{"contains": "SIGTERM_TRAPPED"}]
    }
  },
  {
    "name": "ctx.signal receives SIGINT and handler runs",
    "args": ["src/trap_sigint.js"],
    "signal": "SIGINT",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 130,
      "ready": { "stdout": [{"contains": "READY"}] },
      "stdout": [{"contains": "SIGINT_TRAPPED"}]
    }
  },
  {
    "name": "ctx.signal receives SIGUSR1 without termination",
    "args": ["src/trap_sigusr1.js"],
    "signal": "SIGUSR1",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 0,
      "ready": { "stdout": [{"contains": "READY"}] },
      "stdout": [{"contains": "SIGUSR1_TRAPPED"}]
    }
  },
  {
    "name": "Multiple signal listeners fire in registration order",
    "args": ["src/multi_listener.js"],
    "signal": "SIGTERM",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 0,
      "ready": { "stdout": [{"contains": "READY"}] },
      "stdout": [{"contains": "FIRST"}, {"contains": "SECOND"}]
    }
  },
  {
    "name": "Unhandled SIGTERM auto-exits with conventional code 143",
    "args": ["src/unhandled_sigterm.js"],
    "signal": "SIGTERM",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 143,
      "ready": { "stdout": [{"contains": "READY"}] },
      "stderr": [{"absent": "Uncaught"}]
    }
  },
  {
    "name": "SIGTERM natively interrupts infinite loops when unintercepted",
    "args": ["src/while_true.js"],
    "signal": "SIGTERM",
    "timeout_ms": 5000,
    "expect": {
      "exit_code": 143,
      "ready": { "stdout": [{"contains": "READY"}] }
    }
  }
]
